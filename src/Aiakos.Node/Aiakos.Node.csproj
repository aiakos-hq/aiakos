<Project Sdk="Microsoft.NET.Sdk">

  <!-- Node agent "Ergates" (spec 0001 R34–R40). No business logic: it must not reference the
       orchestrator, the data layer, Akka or Npgsql (ADR 0004). ASP.NET Core is referenced only
       for the hook ingest (spec 0005). Published self-contained for linux-x64, not AOT (D10). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>aiakos-node</AssemblyName>
    <RootNamespace>Aiakos.Node</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Source-generated configuration binding keeps options binding trim- and AOT-safe. -->
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.HealthCheck" />
    <PackageReference Include="Grpc.Net.Client" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aiakos.Contracts\Aiakos.Contracts.csproj" />
    <ProjectReference Include="..\Aiakos.Core\Aiakos.Core.csproj" />
    <ProjectReference Include="..\Aiakos.ServiceDefaults\Aiakos.ServiceDefaults.csproj" />
  </ItemGroup>

</Project>
