<Project Sdk="Microsoft.NET.Sdk">

  <!-- Placeholder tool that claims the NuGet ID (#6). Shared settings come from
       Directory.Build.props (spec 0001 R48); #15 replaces the code under the same ID. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>aiakos</AssemblyName>
    <RootNamespace>Aiakos.Cli</RootNamespace>
    <!-- Run on newer .NET runtimes too, so the tool installs wherever the SDK is 10 or later. -->
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <!-- Packaged as a .NET tool: dotnet tool install -g aiakos -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>aiakos</ToolCommandName>
    <PackageId>Aiakos</PackageId>
    <Version>0.0.1-preview.1</Version>
    <!-- Keep the reported version clean (no +commit suffix). -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Description>Early preview placeholder for the Aiakos CLI, a file-defined control plane for teams of AI coding agents. Not yet functional: it prints a greeting and its version.</Description>
    <PackageTags>ai;agents;claude-code;control-plane;cli</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <ProjectReference Include="..\Aiakos.Spec\Aiakos.Spec.csproj" />
  </ItemGroup>

</Project>
