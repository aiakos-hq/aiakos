<Project Sdk="Microsoft.NET.Sdk">

  <!-- OpenTelemetry and health-check registration shared by the orchestrator and the node
       (spec 0001 R41). No ASP.NET Core dependency: hosts that serve HTTP add ASP.NET Core
       instrumentation themselves. -->
  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Source-generated configuration binding keeps options binding trim- and AOT-safe. -->
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
  </ItemGroup>

</Project>
