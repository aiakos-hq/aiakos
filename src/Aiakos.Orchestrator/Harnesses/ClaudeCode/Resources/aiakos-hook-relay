#!/bin/sh

kind=${1-}
name=${2-}
if [ "$kind" = status ]; then
    seat=${AIAKOS_SEAT-seat}
    printf 'aiakos %s\n' "$seat"
fi

post=1
case "$kind" in hook|status) ;; *) post=0 ;; esac
[ -n "${AIAKOS_HOOK_URL-}" ] || post=0
[ -n "${AIAKOS_SEAT_TOKEN_FILE-}" ] && [ -r "$AIAKOS_SEAT_TOKEN_FILE" ] || post=0
command -v curl >/dev/null 2>&1 || post=0
command -v flock >/dev/null 2>&1 || post=0
command -v cat >/dev/null 2>&1 || post=0

if [ "$post" -eq 1 ]; then
    seq=0
    if [ -n "${AIAKOS_SEAT_SEQ_FILE-}" ]; then
        seqfile=$AIAKOS_SEAT_SEQ_FILE
        lockfile=$seqfile.lock
        if command -v timeout >/dev/null 2>&1; then
            next=$(timeout 1 sh -c '
                seqfile=$1
                lockfile=$2
                now=$3
                exec 9>"$lockfile" 2>/dev/null || exit 1
                flock -w 0.8 9 2>/dev/null || exit 1
                old=$(cat "$seqfile" 2>/dev/null) || old=
                case "$old" in ""|*[!0-9]*) value=$now ;; *) value=$old ;; esac
                value=$((value + 1))
                printf "%s\n" "$value" >"$seqfile" || exit 1
                printf "%s" "$value"
            ' sh "$seqfile" "$lockfile" "$(date +%s%6N 2>/dev/null)" 2>/dev/null </dev/null)
            case "$next" in ""|*[!0-9]*) seq=0 ;; *) seq=$next ;; esac
        fi
    fi
    curl --connect-timeout 0.5 --max-time 2 --silent --output /dev/null \
        --data-binary @- -H 'Expect:' -H 'Content-Type: application/json' \
        -H @"$AIAKOS_SEAT_TOKEN_FILE" \
        -H "X-Aiakos-Source-Seq: $seq" \
        "$AIAKOS_HOOK_URL/$kind/$name" 2>/dev/null
fi
cat >/dev/null 2>&1
exit 0
