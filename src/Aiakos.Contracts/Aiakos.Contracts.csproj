<Project Sdk="Microsoft.NET.Sdk">

  <!-- gRPC/Protobuf contract between orchestrator and node. The .proto files, packages and
       csharp_namespace are owned by spec 0002 (#10); the skeleton only provides the build wiring
       (spec 0001 R44). Server stubs need only Grpc.Core.Api, so the node gains no ASP.NET Core
       dependency from this project. -->
  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Core.Api" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos/**/*.proto" ProtoRoot="Protos" GrpcServices="Both" />
  </ItemGroup>

</Project>
